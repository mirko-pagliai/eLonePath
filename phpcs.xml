<?xml version="1.0"?>
<ruleset>
    <arg value="p"/>
    <arg name="colors"/>

    <file>.</file>

    <rule ref="./vendor/cakephp/cakephp-codesniffer/CakePHP/ruleset.xml"/>

    <rule ref="CakePHP.Commenting.FunctionComment.Missing">
        <severity>0</severity>
    </rule>

    <rule ref="Generic.Files.LineLength.TooLong">
        <severity>0</severity>
    </rule>

    <rule ref="Internal.NoCodeFound">
        <exclude-pattern>/templates/*/*.php</exclude-pattern>
    </rule>

    <rule ref="SlevomatCodingStandard.Commenting.DocCommentSpacing.IncorrectLinesCountBetweenDifferentAnnotationsTypes">
        <severity>0</severity>
    </rule>

    <exclude-pattern>/vendor</exclude-pattern>
</ruleset>