parameters:
    level: 9

    treatPhpDocTypesAsCertain: false

    bootstrapFiles:
        - config/bootstrap.php

    paths:
        - bin
        - config
        - src
        - packages/Core/config
        - packages/Core/src
        - packages/Core/tests
        - packages/Debugger/src
        - packages/Debugger/tests
        - templates
        - tests
        - webroot

    excludePaths:
        - src/Console
