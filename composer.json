{
	"name": "mirko-pagliai/elone-path",
	"description": "eLonePath is a data‑driven engine for interactive gamebooks inspired by classic solo gamebooks of the 1980s, designed to bring the book‑centric experience into the digital space without losing its soul",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": "^8.4",
		"twbs/bootstrap": "5.3.8"
	},
	"require-dev": {
		"cakephp/cakephp-codesniffer": "^5.3.2",
		"josegonzalez/dotenv": "4.0.0",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^13.2",
		"symfony/var-dumper": "^8.1"
	},
	"autoload": {
		"psr-4": {
		  "App\\": "src/"
		},
		"files": [
			"src/Core/global_functions.php"
		]
	},
	"scripts": {
		"run-server": "php -S localhost:9996 -t webroot webroot/index.php",
		"assets": [
			"mkdir -p webroot/css webroot/js",
			"ln -sfn ../../vendor/twbs/bootstrap/dist/css/bootstrap.min.css webroot/css/bootstrap.min.css",
			"ln -sfn ../../vendor/twbs/bootstrap/dist/js/bootstrap.bundle.min.js webroot/js/bootstrap.bundle.min.js"
		],
		"post-install-cmd": [
			"@assets"
		],
		"post-update-cmd": [
			"@assets"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
