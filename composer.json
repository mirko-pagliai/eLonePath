{
	"name": "mirko-pagliai/elone-path",
	"description": "eLonePath is a data‑driven engine for interactive gamebooks inspired by classic solo gamebooks of the 1980s, designed to bring the book‑centric experience into the digital space without losing its soul",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": "^8.4",
		"elone/core": "*",
		"twbs/bootstrap": "5.3.8",
		"symfony/finder": "^8.1",
		"michelf/php-markdown": "^2.0",
		"twbs/bootstrap-icons": "^1.13"
	},
	"require-dev": {
		"cakephp/cakephp-codesniffer": "^5.3.2",
		"elone/debugger": "*",
		"josegonzalez/dotenv": "4.0.0",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^13.2",
		"symfony/var-dumper": "^8.1"
	},
	"repositories": [
		{
			"type": "path",
			"url": "packages/Core"
		},
		{
			"type": "path",
			"url": "packages/Debugger"
		}
	],
	"autoload": {
		"psr-4": {
		  "App\\": "src/"
		},
		"files": [
			"packages/Core/src/global_functions.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Test\\": "tests/TestCase/"
		}
	},
	"scripts": {
		"run-server": "php -S localhost:9996 -t webroot webroot/index.php",
		"assets": "App\\Console\\AssetsInstaller::install",
		"test": "vendor/bin/phpunit --display-all-issues",
		"test-core": "cd packages/Core && vendor/bin/phpunit --display-all-issues",
		"test-debugger": "cd packages/Debugger && vendor/bin/phpunit --display-all-issues",
		"tests": [
			"@test",
			"@test-core",
			"@test-debugger"
		],
		"post-install-cmd": [
			"@assets"
		],
		"post-update-cmd": [
			"@assets"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
