{
	"name": "mirko-pagliai/elone-path",
	"description": "eLonePath is a data‑driven engine for interactive gamebooks inspired by classic solo gamebooks of the 1980s, designed to bring the book‑centric experience into the digital space without losing its soul",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": "^8.4",
		"elone/core": "*",
		"twbs/bootstrap": "5.3.8",
		"symfony/finder": "^8.1"
	},
	"require-dev": {
		"cakephp/cakephp-codesniffer": "^5.3.2",
		"josegonzalez/dotenv": "4.0.0",
		"phpstan/phpstan": "^2.2",
		"phpunit/phpunit": "^13.2",
		"symfony/var-dumper": "^8.1"
	},
	"repositories": [
		{
			"type": "path",
			"url": "packages/Core"
		}
	],
	"autoload": {
		"psr-4": {
		  "App\\": "src/"
		},
		"files": [
			"packages/Core/src/global_functions.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Test\\": "tests/TestCase/"
		}
	},
	"scripts": {
		"run-server": "php -S localhost:9996 -t webroot webroot/index.php",
		"assets": [
			"@php -r \"if (!is_dir('webroot/assets/css')) mkdir('webroot/assets/css', 0777, true); if (!is_dir('webroot/assets/js')) mkdir('webroot/assets/js', 0777, true);\"",
			"@php -r \"copy('vendor/twbs/bootstrap/dist/css/bootstrap.min.css', 'webroot/assets/css/bootstrap.min.css');\"",
			"@php -r \"copy('vendor/twbs/bootstrap/dist/js/bootstrap.bundle.min.js', 'webroot/assets/js/bootstrap.bundle.min.js');\""
		],
		"post-install-cmd": [
			"@assets"
		],
		"post-update-cmd": [
			"@assets"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
